# Base URL of the ChronoPace backend (https://github.com/siddiquezain/chronobrain).
# Local dev:   VITE_API_URL=http://localhost:8000
# Cloudflare Quick Tunnel (browser access to a local backend):
#              VITE_API_URL=https://YOUR-TUNNEL.trycloudflare.com
#
# Copy this file to .env.local (or .env.development.local for dev-mode only)
# and fill in the real value there. Never commit the actual tunnel URL or
# any other real backend address — only .env.example, with no value, is
# tracked in git.
VITE_API_URL=
